[Unit]
Description=Agent Civilization brain: llama-server, loopback only
After=network.target

[Service]
# LLAMA_FLAGS is written by deploy/install.sh from what it finds on the box
# (a GPU with room for the model, or the CPU's performance cores). The model
# and its context/slot layout are in there too; see deploy/README.md.
EnvironmentFile=/etc/agent-civ/llm.env
ExecStart=/opt/agent-civ/llama.cpp/bin/llama-server --host 127.0.0.1 --port 8080 --jinja --metrics $LLAMA_FLAGS
Slice=agentciv.slice
DynamicUser=yes
Restart=on-failure
RestartSec=3
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

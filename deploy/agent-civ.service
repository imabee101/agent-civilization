[Unit]
Description=Agent Civilization
After=network-online.target agent-civ-llm.service
Wants=network-online.target agent-civ-llm.service

[Service]
# HOST, PORT, MODEL_ALIAS and GAME_FLAGS are written by deploy/install.sh from
# /etc/agent-civ/install.env, the one untracked file that knows which box this is.
EnvironmentFile=/etc/agent-civ/game.env
ExecStart=/opt/agent-civ/agentciv --host ${HOST} --port ${PORT} \
  --data /var/lib/agent-civ \
  --tls-cert ${CREDENTIALS_DIRECTORY}/fullchain.pem --tls-key ${CREDENTIALS_DIRECTORY}/key.pem \
  --operator-token-file ${CREDENTIALS_DIRECTORY}/operator-token \
  --brain openai --base-url http://127.0.0.1:8080/v1 --model ${MODEL_ALIAS} $GAME_FLAGS
# GAME_FLAGS holds --max-agents, --concurrency (a ceiling: the engine measures
# the backend and picks the level itself), --max-tokens, --temperature. Slots
# and the prompt budget come from the server's /props.
Slice=agentciv.slice
LoadCredential=fullchain.pem:/etc/agent-civ/tls/fullchain.pem
LoadCredential=key.pem:/etc/agent-civ/tls/key.pem
LoadCredential=operator-token:/etc/agent-civ/operator-token
DynamicUser=yes
StateDirectory=agent-civ
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=3
# The game saves a snapshot and exits within 10 s of SIGTERM on its own.
TimeoutStopSec=30
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

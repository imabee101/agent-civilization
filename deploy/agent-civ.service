[Unit]
Description=Agent Civilization on https://civ.imabee.com
After=network-online.target agent-civ-llm.service
Wants=network-online.target agent-civ-llm.service

[Service]
# Bound to this workstation's own address only: .130 on the same NIC is the
# apsy edge's :443.
ExecStart=/opt/agent-civ/agentciv --host 192.168.101.7 --port 443 \
  --data /var/lib/agent-civ \
  --tls-cert ${CREDENTIALS_DIRECTORY}/fullchain.pem --tls-key ${CREDENTIALS_DIRECTORY}/key.pem \
  --max-agents 12 --concurrency 3 --max-tokens 600 \
  --brain openai --base-url http://127.0.0.1:8080/v1 --model qwen3-4b-2507-abliterated
# --concurrency is a ceiling: the engine measures the backend and picks the
# level itself. Slots and the prompt budget come from the server's /props.
Slice=agentciv.slice
LoadCredential=fullchain.pem:/etc/agent-civ/tls/fullchain.pem
LoadCredential=key.pem:/etc/agent-civ/tls/key.pem
DynamicUser=yes
StateDirectory=agent-civ
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=3
# The game saves a snapshot and exits within 10 s of SIGTERM on its own.
TimeoutStopSec=30
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

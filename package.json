{
  "name": "agent-civilization",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bash scripts/build.sh",
    "test:ui": "bun test tests/ui",
    "test:sandbox": "bun test tests/sandbox",
    "check": "bun run --parallel typecheck test",
    "e2e": "bun scripts/e2e-screens.ts",
    "report": "bun scripts/report.ts"
  },
  "dependencies": {
    "@jitl/quickjs-singlefile-cjs-release-sync": "^0.31.0",
    "pixi.js": "^8.6.6",
    "quickjs-emscripten-core": "^0.31.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.0"
  }
}

{
  "name": "agent-civilization",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bash scripts/build.sh",
    "test:ui": "bun test tests/ui",
    "test:sandbox": "bun test tests/sandbox",
    "check": "bun run --parallel typecheck test",
    "e2e": "bun scripts/e2e-screens.ts",
    "report": "bun scripts/report.ts",
    "bench": "bun scripts/bench-brain.ts"
  },
  "dependencies": {
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.32.0",
    "pixi.js": "8.21.0",
    "quickjs-emscripten-core": "0.32.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.4.2",
  "license": "UNLICENSED",
  "engines": {
    "bun": ">=1.4.0"
  }
}
